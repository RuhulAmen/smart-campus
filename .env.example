# ==============================================================================
# Smart Campus Management System — Environment Configuration Template
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smart_campus
MONGO_DB_NAME=smart_campus
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Application Security
# Generate a cryptographically secure 64-char key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-64-character-secret-key-here
JWT_EXPIRATION_HOURS=24

# CORS & Network Settings
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
PORT=5000
DEBUG=True

# Email Notification Service (SMTP)
# Leave unconfigured to use simulated console fallback logging
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@campus.edu
SMTP_PASSWORD=your-app-specific-password
SMTP_USE_TLS=true
SMTP_FROM=Smart Campus <notifications@campus.edu>
